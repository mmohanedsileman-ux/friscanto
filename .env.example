# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Set this secret in AI Studio Secrets or Vercel Environment Variables
# to lock the Firstcanto Admin Dashboard with a fixed server-side password.
ADMIN_PASSWORD=

# SESSION_SECRET: Random secret string used to sign admin session tokens on Vercel.
SESSION_SECRET=

# Optional for Vercel persistent cloud storage (Vercel Storage -> Upstash Redis adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
