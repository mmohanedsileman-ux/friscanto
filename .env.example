# ADMIN_PASSWORD: Set this secret in Vercel Environment Variables or AI Studio Secrets
# to lock the Firstcanto Admin Dashboard with a fixed server-side password.
ADMIN_PASSWORD=

# SESSION_SECRET: Strong random secret (at least 32 chars) used to sign admin JWT tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ALLOWED_ORIGINS: Optional comma-separated list of trusted production origins for CORS
# (e.g. https://friscanto.vercel.app). Same-origin requests are allowed automatically.
ALLOWED_ORIGINS=

# Optional for Vercel persistent cloud storage (Vercel Storage -> Upstash Redis adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
