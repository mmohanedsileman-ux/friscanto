# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Set this secret in AI Studio Secrets or Vercel Environment Variables
# to lock the Firstcanto Admin Dashboard with a fixed server-side password.
ADMIN_PASSWORD=

# Optional for Vercel persistent cloud storage (Upstash / Vercel KV REST API)
KV_REST_API_URL=
KV_REST_API_TOKEN=
